---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    {%- assign title_display = page.title -%}
    {%- if page.lang == 'en' and page.title_en and page.title_en != empty -%}
      {%- assign title_display = page.title_en -%}
    {%- endif -%}
    <h1
      class="post-title"
      data-i18n-field
      data-es="{{ page.title | escape }}"
      data-en="{{ page.title_en | escape }}"
    >
      {{- title_display -}}
    </h1>
    {%- assign description_display = page.description -%}
    {%- if page.lang == 'en' and page.description_en and page.description_en != empty -%}
      {%- assign description_display = page.description_en -%}
    {%- endif -%}
    <p
      class="post-description"
      data-i18n-field
      data-es="{{ page.description | escape }}"
      data-en="{{ page.description_en | escape }}"
    >
      {{- description_display -}}
    </p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
